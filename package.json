{
  "name": "word-quiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Word quiz with SQLite, run locally on Windows",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "smoke:win": "bash scripts/win-smoke.sh",
    "smoke:win-db": "bash scripts/win-db-check.sh",
    "smoke:import": "bash scripts/import-e2e.sh",
    "smoke:server": "bash scripts/server-e2e.sh",
    "smoke:package": "bash scripts/package-e2e.sh",
    "dev": "node scripts/dev.mjs",
    "dev:seed": "node scripts/dev.mjs --seed",
    "shots": "bash scripts/shots.sh"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mui/material": "9.4.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "jsdom": "30.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.10",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.3.0"
  }
}
